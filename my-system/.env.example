# My-System Environment Template
# Copy this file to .env and fill in your values

LOG_LEVEL=info
DEBUG=true
PORT=3000

# Dashboard Security
# NOTE: The system now supports multi-user hashed auth in config/users.json
# You can still set a primary admin here if needed.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your_secure_password_here
DASHBOARD_HOST=0.0.0.0

# Automated Workflow
AUTO_OPEN_DASHBOARD=true

# ──────────────────────────────────────────────
# AI FORGE — Code Generation APIs
# ──────────────────────────────────────────────
# Gemini API Key (free quota available)
# Get yours at: https://aistudio.google.com/app/apikey
# Used as fallback when Ollama is offline or prompt is unknown.
# Note: Built-in templates (snake, calculator, todo, etc.) do NOT need this key.
GEMINI_API_KEY=your_gemini_api_key_here
