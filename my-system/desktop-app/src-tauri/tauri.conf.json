{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xeyal-system",
  "version": "1.5.1",
  "identifier": "pro.antigravity.xeyal-system",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "My-System: Autonomous Developer OS",
        "width": 1000,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../cli/**/*",
      "../../core/**/*",
      "../../commands/**/*",
      "../../plugins/**/*",
      "../../config/**/*",
      "../../package.json"
    ]
  }
}
